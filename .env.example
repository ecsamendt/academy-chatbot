# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (docker-compose starts this for local development) ---
DATABASE_URL=postgresql://coach:coach@db:5432/coach

# --- OpenAI ---
OPENAI_API_KEY=
# Confirm current model names in the OpenAI dashboard before launch.
ANSWER_MODEL=gpt-5
CLASSIFY_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# whisper-1 returns segment timestamps, which the timestamp links need.
TRANSCRIBE_MODEL=whisper-1

# --- Shared secrets with the WordPress plugin (generate long random strings) ---
# Signs the short-lived member token the chat window sends with each question.
MEMBER_TOKEN_SECRET=
# Signs the "lesson published/updated/deleted" webhook from WordPress.
WEBHOOK_SECRET=
# WordPress sends this header when calling the lessons REST endpoint, and vice versa.
WP_INGEST_SECRET=
# Staff-only admin endpoints (re-index). The WordPress plugin stores it too.
ADMIN_API_KEY=

# --- WordPress ---
WP_BASE_URL=https://academy.susociodenegocios.com

# --- Vimeo (personal access token with the "private" and "video_files" scopes) ---
VIMEO_ACCESS_TOKEN=

# --- Chat window origin(s) allowed to call the service, comma separated ---
CORS_ORIGINS=https://academy.susociodenegocios.com

# --- Retrieval tuning (cosine similarity, 0-1) ---
MATCH_STRONG=0.50
MATCH_PARTIAL=0.35
TOP_K=6
